# Copy to .env in the project root (or backend/config/) and fill in real values.
# Never commit the real file. On Render, set these in the dashboard or render.yaml instead.

# Database Configuration
DATABASE_URL=postgresql://user:your_password@localhost:5432/spooky_planner
# TLS to the database. Leave false for local Postgres and Render's internal URL.
# true = TLS without certificate check (Render external URL). verify = TLS with certificate check.
DATABASE_SSL=false

# API Configuration
COLLEGE_SCORECARD_API_KEY=exampleAPIKey

# Server Configuration
NODE_ENV=development
# Render sets PORT itself. The server binds 0.0.0.0 on this port.
PORT=3000

# CORS: comma-separated list of extra allowed frontend origins.
# Optional: the frontend is served by this server, so same-origin requests work without it.
CORS_ORIGIN=http://localhost:5500

# Rate limits (optional). Counts are per client IP.
# Window for the general and lookup limits, in milliseconds (default 900000 = 15 minutes).
RATE_LIMIT_WINDOW_MS=900000
# All /api routes except /api/health (default 300 per window).
RATE_LIMIT_MAX=300
# /api/lookup, which calls the College Scorecard API (default 60 per window).
RATE_LIMIT_LOOKUP_MAX=60
# POST /api/students (default 10 per students window).
RATE_LIMIT_STUDENTS_MAX=10
# Window for the students limit, in milliseconds (default 3600000 = 1 hour).
RATE_LIMIT_STUDENTS_WINDOW_MS=3600000
